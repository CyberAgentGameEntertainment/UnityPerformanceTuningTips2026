% reviewlistlst 系環境を使う。配色・折り返し・キャプションはここで作り直す。
\ifdefined\review@highlightlatex
% 既定は白地。印刷の網点とインク量を抑えるため、暗色は使わない。
% 明色側は1色（スミ）印刷でも読み分けられるよう、グレー変換したときの濃度が
% キーワード＞地の文＞文字列＞コメントの順になる色を選び、太字・斜体も併用する。
% Web版と同じ暗色にする場合は次を \reviewcodedarktrue にする。
\newif\ifreviewcodedark
\reviewcodedarkfalse
\ifreviewcodedark
  \definecolor{reviewcodebg}{HTML}{191A1C}
  \definecolor{reviewcodefg}{HTML}{BDBDBD}
  \definecolor{reviewcodekeyword}{HTML}{6C95EB}
  \definecolor{reviewcodestring}{HTML}{C9A26D}
  \definecolor{reviewcodecomment}{HTML}{85C46C}
  \definecolor{reviewcodegutter}{HTML}{808080}
\else
  \definecolor{reviewcodebg}{HTML}{F2F3F5}      % スミ 5%
  \definecolor{reviewcodefg}{HTML}{3C3C3C}      % スミ 76%
  \definecolor{reviewcodekeyword}{HTML}{10265E} % スミ 85%（＋太字）
  \definecolor{reviewcodestring}{HTML}{7A4A12}  % スミ 68%
  \definecolor{reviewcodecomment}{HTML}{4A6B3A} % スミ 64%（＋斜体）
  \definecolor{reviewcodegutter}{HTML}{8C8C8C}  % スミ 45%
\fi
\@ifpackageloaded{listings}{%
  % C#の #if / #region を色分けするために directives アスペクトを読み込む。
  \lstloadaspects{directives}
  % Re:VIEWは //list[..][..][lang] の lang をそのまま language= へ渡すため、
  % listings が知らない名前が1つでもあるとビルドが止まる。
  \lstdefinelanguage{csharp}[Sharp]{C}{%
    morekeywords={var,dynamic,async,await,yield,partial,record,init,%
      nameof,where,when,with,global,required,scoped,nint,nuint},%
    moredelim=*[directive]\#,%
    moredirectives={define,undef,if,elif,else,endif,line,error,warning,%
      region,endregion,pragma,nullable},%
    sensitive=true,%
  }
  \lstalias[]{objc}[Objective]{C}
  \lstalias{cpp}{C++}
  \lstdefinelanguage{hlsl}[ANSI]{C}{%
    morekeywords={half,half2,half3,half4,fixed,fixed2,fixed3,fixed4,%
      float2,float3,float4,float2x2,float3x3,float4x4,int2,int3,int4,%
      uint,uint2,uint3,uint4,bool2,bool3,bool4,matrix,vector,%
      Texture2D,Texture2DArray,Texture3D,TextureCube,RWTexture2D,SamplerState,%
      StructuredBuffer,RWStructuredBuffer,ByteAddressBuffer,ConstantBuffer,%
      cbuffer,tbuffer,groupshared,register,packoffset,numthreads,%
      inout,uniform,nointerpolation,centroid,noperspective,%
      sampler2D,sampler3D,samplerCUBE,tex2D,tex3D,texCUBE,lerp,saturate,mul},%
    sensitive=true,%
  }
  \lstdefinelanguage{yaml}{%
    morekeywords={true,false,null,yes,no,on,off},%
    morecomment=[l]\#,%
    morestring=[b]",%
    morestring=[b]',%
    sensitive=false,%
  }
  \lstdefinelanguage{text}{}
  \lstset{%
    basicstyle=\ttfamily\footnotesize\color{reviewcodefg},%
    identifierstyle=\color{reviewcodefg},%
    keywordstyle=\bfseries\color{reviewcodekeyword},%
    directivestyle=\color{reviewcodekeyword},%
    commentstyle=\itshape\color{reviewcodecomment},%
    stringstyle=\color{reviewcodestring},%
    numberstyle=\ttfamily\scriptsize\color{reviewcodegutter},%
    numbersep=0.8em,%
    backgroundcolor=\color{reviewcodebg},%
    frame=single,framerule=0pt,rulecolor=\color{reviewcodebg},%
    % breakautoindent は columns=fullflexible だと効かない（fixed にすると和文が
    % 字間空きになる）。折り返し行は breakindent で一段下げて見分ける。
    breaklines=true,breakatwhitespace=false,breakautoindent=false,breakindent=2em,%
    columns=fullflexible,keepspaces=true,fontadjust=true,%
    showstringspaces=false,upquote=true,%
    % ラテン1補助の記号（×±など）はlistingsの中でinputencのUTF-8処理が壊れるので、
    % 8bit文字を素通しさせたうえで置換して出す。全角・CJK域の記号は素のままで通る。
    extendedchars=true,%
    literate={×}{{\texttimes}}1 {±}{{\textpm}}1,%
    % 余白は枠を版面より少し外へ広げて作る。xleftmargin で内側へ寄せると、
    % breaklines で折り返した行が枠の外に出てしまう。
    framesep=0.7em,framexleftmargin=0pt,framexrightmargin=0pt,%
    xleftmargin=0pt,xrightmargin=0pt,%
    aboveskip=\baselineskip,belowskip=0.5\baselineskip,%
    captionpos=t,%
  }
  % キャプションは従来の \reviewlistcaption と同じ体裁（左寄せ・▼付き）に戻す。
  % listings は \lst@maketitle を \AtBeginDocument で書き換えるため、後から上書きする。
  \def\review@fnumlstlisting{{\lstlistingnamestyle\lstlistingname
    \ifx\lst@@caption\@empty\else\thelstlisting\fi}}
  \long\def\review@lstmakecaption#1#2{%
    {\def\captionhead{\sffamily{\color{black!30!white}{▼}}}%
     \buildcaption{}{#1}{#2}}\par\vskip2pt}
  \long\def\review@lstmaketitle#1{%
    {\def\captionhead{\sffamily{\color{black!30!white}{▼}}}%
     \buildcaption{}{}{#1}}\par\vskip2pt}
  \AtBeginDocument{%
    \let\fnum@lstlisting\review@fnumlstlisting
    \let\lst@makecaption\review@lstmakecaption
    \let\lst@maketitle\review@lstmaketitle
  }
}{}
\fi
