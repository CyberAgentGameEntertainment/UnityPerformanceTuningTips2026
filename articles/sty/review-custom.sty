% 章扉・部扉（articles/editorial-structure.json を使う全体ビルドだけに出す）
% 背景の塗りはatbegshiで置きます。eso-pic（pxesopic）はplautopatchの
% 読み込みフックと衝突してビルドが止まるため使いません。
\RequirePackage{atbegshi}
\definecolor{reviewdividerink}{HTML}{2B2B2B}

% atbegshiの原点は「TeXの原点から1インチ左上」です。トンボ付き（media=print）は
% TeXの原点が仕上がり位置なので、1インチ分だけ右下に戻してから塗ります。
\newlength{\reviewdividerorigin}
\setlength{\reviewdividerorigin}{\z@}
% 塗り足し。トンボ付きではgentombowのBleedBoxと同じ幅にそろえる。
\newlength{\reviewdividerbleed}
\setlength{\reviewdividerbleed}{3mm}
\AtBeginDocument{%
  \@ifpackageloaded{gentombow}{%
    \setlength{\reviewdividerorigin}{1in}%
    \setlength{\reviewdividerbleed}{\@tombowbleed}}{}}

% 仕上がり紙面の左上を原点に、塗り足しまで含めた紙面いっぱいに#1を置く。
% atbegshiの\AtBeginShipoutUpperLeftの中で使い、幅を取らないので続けて重ねられる。
\newcommand{\reviewdividerbleedbox}[1]{%
  \kern\dimexpr\reviewdividerorigin-\reviewdividerbleed\relax
  \rlap{\raisebox{-\dimexpr\reviewdividerorigin+\paperheight+\reviewdividerbleed\relax}[\z@][\z@]{#1}}%
  \kern-\dimexpr\reviewdividerorigin-\reviewdividerbleed\relax}
% 塗り足しを含まない仕上がり紙面いっぱいに#1を置く。
\newcommand{\reviewdividertrimbox}[1]{%
  \kern\reviewdividerorigin
  \rlap{\raisebox{-\dimexpr\reviewdividerorigin+\paperheight\relax}[\z@][\z@]{#1}}%
  \kern-\reviewdividerorigin}

% 地色を塗るページでは隠しノンブルを白抜きにする。
\newif\ifreviewdividerpage

% 紙面いっぱいの地色（塗り足しまで）。
\newcommand{\reviewdividerbackground}{%
  \global\reviewdividerpagetrue
  \AtBeginShipoutNext{%
    \AtBeginShipoutUpperLeft{%
      \reviewdividerbleedbox{\textcolor{reviewdividerink}{%
        \rule{\dimexpr\paperwidth+2\reviewdividerbleed\relax}%
          {\dimexpr\paperheight+2\reviewdividerbleed\relax}}}}}}

% 隠しノンブル（config-jp.yml の hiddenfolio=nikko-pc）。印刷所が丁合を確かめる
% ため、扉・白ページを含む全ページのノドに入れる。review-jsbook.cls は
