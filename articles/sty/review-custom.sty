% 本文中の型名・API名（CommandBuffer など）は英語のハイフネーションで
% 「Command-Buffer」のように名前にないハイフンが入るため、review-ext.rb が
% \reviewnohyphen で囲み、語の区切り（\reviewidbreak）でだけハイフンなしで改行する。
\DeclareRobustCommand{\reviewnohyphen}[1]{{\language\l@nohyphenation#1}}
\DeclareRobustCommand{\reviewidbreak}{\discretionary{}{}{}}
% 原稿で表の列幅（mm）を明示した表は、列幅とセルの余白の合計が版面幅を超える場合だけ
% 比率を保って縮める。収まる表は指定どおり 1mm 単位のまま。
% #1: 列幅の合計（mm）, #2: 列数
\newdimen\reviewtsizeunit
\newcommand{\reviewfittsize}[2]{%
  \reviewtsizeunit=\dimexpr\linewidth-#2\tabcolsep*2-\numexpr#2+1\relax\arrayrulewidth\relax
  \reviewtsizeunit=\dimexpr\reviewtsizeunit*\number\dimexpr1mm\relax/\number\dimexpr#1mm\relax\relax
  \ifdim\reviewtsizeunit>1mm \reviewtsizeunit=1mm\fi}
