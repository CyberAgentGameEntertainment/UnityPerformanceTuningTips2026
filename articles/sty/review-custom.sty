% 章見出しの上部の余白を無効化
% for user-defined macro
\def\@makechapterhead#1{%
%  \vspace*{2\Cvs}% 欧文は50pt →上空きを無効化
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        % 章扉は置かない（全体ビルドでは部扉だけを立て、記事プレビューには扉を置かない）。
        \huge\headfont \@chapapp\thechapter\@chappos % 第x章
        \par\nobreak
        \vskip \Cvs % 欧文は20pt
      \fi
    \fi
    \interlinepenalty\@M
    \Huge \headfont #1\par\nobreak % 章タイトル
    \vskip 3\Cvs}} % 欧文は40pt
% 見出しの上下の余白を詰めた番号なし章見出し。目次と、原稿で
% \reviewcompactschapterhead を置いた直後の番号なし章に1回だけ使う
\newif\ifreview@compactschapterhead
\newcommand{\reviewcompactschapterhead}{\global\review@compactschapterheadtrue}
\let\review@origmakeschapterhead\@makeschapterhead
\def\@makeschapterhead#1{%
  \ifreview@compactschapterhead
    \global\review@compactschapterheadfalse
    {\parindent \z@ \raggedright
      \normalfont
      \interlinepenalty\@M
      \Huge \headfont #1\par\nobreak
      \vskip 1.5\Cvs}%
  \else
    \review@origmakeschapterhead{#1}%
  \fi}
