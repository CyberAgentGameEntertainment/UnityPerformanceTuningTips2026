% デザイナー支給の扉（1ページ目が大扉、2ページ目以降が第1部からの部扉）。
% 仕上がりサイズで塗り足しなしの支給なので、塗り足しをこちらで補う。
% 支給データはレイヤーを統合済みのIllustrator PDFをそのまま置く。
% \reviewdividerdesignpages は支給PDFのページ数で、テストが実物と照合する。
%ファイルがないか、部の数がページ数を超えたら組み版の扉を出す。
\providecommand{\reviewdividerdesign}{/book/articles/images/divider/tuning-tips-2026-interior.pdf}
\providecommand{\reviewdividerdesignpages}{5}
\newcommand{\reviewdividerdesignpage}[1]{%
  \global\reviewdividerpagetrue
  \xdef\reviewdividerdesign@page{\the\numexpr#1\relax}%
  \AtBeginShipoutNext{%
    \AtBeginShipoutUpperLeft{%
      % 塗り足しは同じ扉を塗り足し寸法まで伸ばして敷く。扉の外周は地色だけなので、
      % 地色と同じ色空間（K90%）のまま塗り足しが埋まる。その上に、仕上がり位置へ
      % 原寸の扉を重ねる。
      \reviewdividerbleedbox{%
        \includegraphics[page=\reviewdividerdesign@page,
          width=\dimexpr\paperwidth+2\reviewdividerbleed\relax,
          height=\dimexpr\paperheight+2\reviewdividerbleed\relax]{\reviewdividerdesign}}%
      \reviewdividertrimbox{%
        \includegraphics[page=\reviewdividerdesign@page,
          width=\paperwidth,height=\paperheight]{\reviewdividerdesign}}}}%
  \null}
% 支給の扉の#1ページ目があれば#2、なければ#3。
\newcommand{\reviewifdividerdesign}[3]{%
  \IfFileExists{\reviewdividerdesign}{%
    \ifnum\numexpr#1\relax>\reviewdividerdesignpages\relax
      \PackageWarning{review-custom}{%
        \reviewdividerdesign\space has no page \the\numexpr#1\relax;
        using the typeset divider}%
      #3%
    \else #2\fi}{#3}}

% 大扉。支給の扉の1ページ目を置く。なければ書名を組む。
\newcommand{\reviewtitlepage}{%
  \begin{titlepage}%
    \reviewifdividerdesign{1}{%
      \includefullpagegraphics[page=1,width=\paperwidth,height=\paperheight]{\reviewdividerdesign}}{%
      \null\vfil
      \begin{center}\headfont\Huge\review@booktitlename\end{center}%
      \vfil\null}%
  \end{titlepage}\clearpage}

% 部扉。構成定義を使わないビルドでは従来どおりの部扉を出します。
\let\reviewjsbook@part\@part
\def\@part[#1]#2{%
  \ifdefined\reviewstructuredbook
    % hyperrefが元の\@partに付けていたアンカーを引き継ぐ
    \ifdefined\Hy@secnum@part
      \ifnum\Hy@secnum@part>\c@secnumdepth \phantomsection\fi
    \fi
    \ifnum \c@secnumdepth >-2\relax
      \refstepcounter{part}%
      \addcontentsline{toc}{part}{\prepartname\thepart\postpartname\hspace{1zw}#1}%
    \else
      \addcontentsline{toc}{part}{#1}%
    \fi
    \markboth{}{}%
    \reviewifdividerdesign{\value{part}+1}{%
      \reviewdividerdesignpage{\value{part}+1}}{%
      \reviewdividerbody{PART}{\reviewdividertwodigit{part}}%
        {\prepartname\thepart\postpartname}{#2}}%
    \@endpart
  \else
    \reviewjsbook@part[#1]{#2}%
  \fi}

% 章（はじめに・目次・序章・動向・おわりになども含む）は左ページから始めて
% 見開きに組み、部扉だけを右ページに置く。部扉の裏は白紙にせず次の章を始める。
\@openlefttrue\@openrightfalse
\let\cleardoublepage\pltx@cleartoleftpage
\renewcommand\part{%
  \pltx@cleartooddpage
  \thispagestyle{empty}%
  \@restonecolfalse
  \null\vfil
  \secdef\@part\@spart}
\def\@endpart{\vfil\newpage}
% 奥付のページの上部に免責事項を置く
